---
import { formatRatingText, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    showEmpty?: boolean;
}

const { rating, showEmpty = false } = Astro.props;
---

{(rating !== null || showEmpty) && (
    <div class="flex items-center">
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            {rating !== null && <span class="text-yellow-400" aria-hidden="true">{formatStarRating(rating)}</span>}
            <span>{formatRatingText(rating)}</span>
        </span>
    </div>
)}
